# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: Connection string for PostgreSQL database
# Format: postgresql://USER:PASSWORD@HOST:5432/protein_golmohammadi?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/protein_golmohammadi"

# PORT: Server port (must be 3000 in AI Studio environment)
PORT=3000

# NODE_ENV: Runtime environment (development | production)
NODE_ENV=development

# JWT_SECRET: Secret key for signing JSON Web Tokens (min 32 characters)
JWT_SECRET="CHANGE_THIS_IN_PRODUCTION_MIN_32_CHARS_SECRET_KEY"

# JWT_EXPIRES_IN: Token expiration duration
JWT_EXPIRES_IN="7d"

# CORS_ORIGIN: Comma-separated allowed origins
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"

# ADMIN_EMAIL: Default bootstrap administrator email
ADMIN_EMAIL="admin@golmohamadi.com"

# ADMIN_INITIAL_PASSWORD: Administrator initial password
ADMIN_INITIAL_PASSWORD="Admin@PG2026!"
